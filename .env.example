# Local development only. Copy to .env and choose a password.
# Quote values containing #. Avoid ${...} sequences in .env passwords:
# Python dotenv may interpolate them even inside single quotes.
POSTGRES_DB=architect
POSTGRES_USER=architect
POSTGRES_PASSWORD='architect_local_only'
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional alternative; overrides POSTGRES_* for the host-run backend only.
# Percent-encode credentials when supplying a URL. Never prefix secrets with VITE_.
# DATABASE_URL=postgresql+psycopg://user:encoded_password@localhost:5432/architect
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
